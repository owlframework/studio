{
    "name": "owlframework/studio",
    "description": "A lightweight custom PHP MVC framework",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Emmanuel Austin",
            "homepage": "https://owl.ng"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        },
        "files": [
            "core/Config.php",
            "core/Functions.php",
            "core/ErrorHandler.php",
            "Nest.php"
        ]
    },
    "minimum-stability": "stable"
}